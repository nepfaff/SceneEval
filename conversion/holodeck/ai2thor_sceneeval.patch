+        /// <summary>
+        /// Export door and window mesh data as OBJ strings.
+        /// This action is used by SceneEval to extract door/window 3D geometry
+        /// for room view renders and GLB exports.
+        /// </summary>
+        public void ExportDoorWindowMeshes() {
+            var result = new Dictionary<string, object>();
+            var meshes = new List<Dictionary<string, object>>();
+
+            foreach (SimObjPhysics sop in physicsSceneManager.ObjectIdToSimObjPhysics.Values) {
+                if (sop.Type == SimObjType.Doorway || sop.Type == SimObjType.Window) {
+                    var meshFilters = sop.GetComponentsInChildren<MeshFilter>();
+
+                    // Combine all meshes for this object into one OBJ
+                    // Keep vertices in local space relative to sop.transform
+                    var combinedObjLines = new List<string>();
+                    combinedObjLines.Add($"o {sop.ObjectID}");
+
+                    int vertexOffset = 0;
+                    int meshCount = 0;
+                    var sopTransform = sop.transform;
+
+                    foreach (var mf in meshFilters) {
+                        if (mf.sharedMesh == null) continue;
+
+                        var mesh = mf.sharedMesh;
+                        var meshTransform = mf.transform;
+
+                        // Transform vertices to sop's local space (not world space)
+                        // This way all sub-meshes are combined relative to the object's origin
+                        foreach (var v in mesh.vertices) {
+                            // Local vertex -> world -> sop local
+                            var worldV = meshTransform.TransformPoint(v);
+                            var localV = sopTransform.InverseTransformPoint(worldV);
+                            combinedObjLines.Add($"v {localV.x} {localV.y} {localV.z}");
+                        }
+
+                        // Add faces with offset vertex indices
+                        for (int i = 0; i < mesh.triangles.Length; i += 3) {
+                            int v1 = mesh.triangles[i] + 1 + vertexOffset;
+                            int v2 = mesh.triangles[i + 1] + 1 + vertexOffset;
+                            int v3 = mesh.triangles[i + 2] + 1 + vertexOffset;
+                            combinedObjLines.Add($"f {v1} {v2} {v3}");
+                        }
+
+                        vertexOffset += mesh.vertexCount;
+                        meshCount++;
+                    }
+
+                    if (meshCount > 0) {
+                        // Use sop's world transform for positioning
+                        var worldPos = sopTransform.position;
+                        var worldRot = sopTransform.eulerAngles;
+                        var worldScale = sopTransform.lossyScale;
+
+                        meshes.Add(new Dictionary<string, object> {
+                            {"objectId", sop.ObjectID},
+                            {"type", sop.Type.ToString()},
+                            {"objData", string.Join("\n", combinedObjLines)},
+                            {"position", new float[] {worldPos.x, worldPos.y, worldPos.z}},
+                            {"rotation", new float[] {worldRot.x, worldRot.y, worldRot.z}},
+                            {"scale", new float[] {worldScale.x, worldScale.y, worldScale.z}},
+                            {"meshCount", meshCount}
+                        });
+                    }
+                }
+            }
+
+            result["meshes"] = meshes;
+            result["count"] = meshes.Count;
+
+            if (meshes.Count == 0) {
+                Debug.Log("ExportDoorWindowMeshes: No door/window meshes found.");
+            } else {
+                Debug.Log($"ExportDoorWindowMeshes: Exported {meshes.Count} combined mesh(es) with total sub-meshes counted.");
+            }
+
+            actionFinishedEmit(success: true, actionReturn: result);
+        }
+
+        /// <summary>
+        /// Export all architecture (walls, floors, doors, windows) as a GLB file with materials/textures.
+        /// Returns GLB data as base64 string.
+        /// Requires UnityGLTF package (org.khronos.unitygltf).
+        /// </summary>
+        public void ExportArchitectureGLB() {
+            try {
+                // Find all architecture objects
+                var architectureRoot = new GameObject("ArchitectureExport");
+                var objectsToExport = new List<GameObject>();
+
+                // Find structure objects (walls, floors, ceilings)
+                var structureRoot = GameObject.Find("Structure");
+                if (structureRoot != null) {
+                    // Clone structure for export
+                    var structureClone = UnityEngine.Object.Instantiate(structureRoot);
+                    structureClone.transform.SetParent(architectureRoot.transform);
+                    structureClone.name = "Structure";
+                    objectsToExport.Add(structureClone);
+                }
+
+                // Find door and window objects
+                foreach (SimObjPhysics sop in physicsSceneManager.ObjectIdToSimObjPhysics.Values) {
+                    if (sop.Type == SimObjType.Doorway || sop.Type == SimObjType.Window) {
+                        var clone = UnityEngine.Object.Instantiate(sop.gameObject);
+                        clone.transform.SetParent(architectureRoot.transform);
+                        clone.name = sop.ObjectID;
+                        objectsToExport.Add(clone);
+                    }
+                }
+
+                if (objectsToExport.Count == 0) {
+                    Destroy(architectureRoot);
+                    actionFinishedEmit(success: false, errorMessage: "No architecture objects found to export");
+                    return;
+                }
+
+                // Use UnityGLTF to export
+                var exportContext = new UnityGLTF.ExportContext();
+                var exporter = new UnityGLTF.GLTFSceneExporter(
+                    new Transform[] { architectureRoot.transform },
+                    exportContext
+                );
+
+                // Export to byte array
+                var glbBytes = exporter.SaveGLBToByteArray("architecture");
+
+                // Cleanup
+                Destroy(architectureRoot);
+
+                if (glbBytes != null && glbBytes.Length > 0) {
+                    var base64Data = System.Convert.ToBase64String(glbBytes);
+
+                    var result = new Dictionary<string, object> {
+                        {"glbBase64", base64Data},
+                        {"byteLength", glbBytes.Length},
+                        {"objectCount", objectsToExport.Count}
+                    };
+
+                    Debug.Log($"ExportArchitectureGLB: Exported {objectsToExport.Count} objects, {glbBytes.Length} bytes");
+                    actionFinishedEmit(success: true, actionReturn: result);
+                } else {
+                    actionFinishedEmit(success: false, errorMessage: "UnityGLTF export failed - empty result");
+                }
+            } catch (System.Exception e) {
+                Debug.LogError($"ExportArchitectureGLB error: {e.Message}\n{e.StackTrace}");
+                actionFinishedEmit(success: false, errorMessage: $"Export error: {e.Message}");
+            }
+        }
